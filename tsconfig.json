{
  "compilerOptions": {
    "target": "esnext",
    // Using TypeScript, node.js and the TypeScript compiler option "module": "esnext" together is next to impossible. So if you're building code that should be ran with node.js, in 2020, you should still choose "module": "commonjs".
    "module": "commonjs",
    "outDir": "build",
    "rootDir": "src",
    "strict": true,
    "checkJs": false,
    "allowJs": true,
    "moduleResolution": "node",
    "strictNullChecks": false,
    "types": ["node", "jest"],
    "incremental": true,
    "lib": ["es2020"],
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "allowUnreachableCode": true,
    "resolveJsonModule": true,
    // Don't think this is needed... using for tests in ts but doesnt seem to do anything
    "allowSyntheticDefaultImports": true
  },
  "include": ["src/**/*.ts", "src/**/*.js"],
  "exclude": ["node_modules", "<node_internals>/**", "**/*.test.ts", "**/*.test.js", "./build/**/*", "./__tests__/**/*"]
}
