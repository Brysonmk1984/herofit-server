{
  "name": "stravat-cognito",
  "version": "1.9.8",
  "description": "Backend for HeroFit",
  "main": "start.js",
  "scripts": {
    "test": "jest --verbose --ci",
    "test:precommit": "jest --verbose --ci --forceExit",
    "test:watch": "jest --watch --verbose ",
    "start": "NODE_ENV=production node build/start.js",
    "dev": "NODE_ENV=development ts-node-dev --respawn --transpile-only src/start.js",
    "prepare": "husky install",
    "prettier": "prettier --check .",
    "lint": "eslint ./**/*.ts",
    "build": "tsc -p tsconfig.json",
    "heroku-postbuild": "tsc -p tsconfig.json && node build/jwt/generateKeyPair.js && mv -i -v src/patchDetails build/patchDetails && mv -i -v src/heroList.json && rm -v -rf src"
  },
  "jest": {
    "watchPathIgnorePatterns": [
      "node_modules"
    ],
    "testEnvironment": "node",
    "setupFilesAfterEnv": [
      "<rootDir>__tests__/setup/nullOrAny.setup.js",
      "jest-extended"
    ],
    "testPathIgnorePatterns": [
      "<rootDir>__tests__/setup",
      "<rootDir>__tests__/activityTraits",
      "<rootDir>__tests__/itemFind",
      "<rootDir>__tests__/itemRewards"
    ],
    "preset": "ts-jest",
    "testMatch": [
      "<rootDir>/__tests__/**/*.test.js"
    ],
    "globals": {
      "ts-jest": {
        "diagnostics": false
      }
    }
  },
  "author": "Bryson Kruk",
  "license": "MIT",
  "devDependencies": {
    "@types/jest": "^27.0.3",
    "eslint": "^3.19.0",
    "eslint-config-standard": "^10.2.1",
    "eslint-plugin-import": "^2.22.1",
    "eslint-plugin-node": "^4.2.2",
    "eslint-plugin-promise": "^3.5.0",
    "eslint-plugin-standard": "^3.0.1",
    "husky": "^7.0.4",
    "jest": "^27.0.3",
    "jest-extended": "^0.11.5",
    "prettier": "^2.5.1",
    "supertest": "^3.4.2",
    "ts-jest": "^27.1.2",
    "ts-node": "^10.4.0",
    "ts-node-dev": "^1.1.8",
    "typescript": "^4.5.4"
  },
  "dependencies": {
    "axios": "^0.21.4",
    "base64url": "^3.0.1",
    "body-parser": "^1.19.0",
    "chance": "^1.1.7",
    "connect-flash": "^0.1.1",
    "cors": "^2.8.3",
    "dotenv": "^6.2.0",
    "express": "^4.17.1",
    "express-fileupload": "^1.2.0",
    "express-response-formatter": "^2.0.2",
    "express-validator": "^6.10.0",
    "jsonwebtoken": "^8.5.1",
    "jwk-to-pem": "^2.0.4",
    "moment": "^2.29.1",
    "morgan": "^1.10.0",
    "nodemailer": "^6.6.1",
    "passport": "^0.4.1",
    "passport-http": "^0.3.0",
    "passport-jwt": "^4.0.0",
    "passport-local": "^1.0.0",
    "pg": "^8.7.1",
    "pg-hstore": "^2.3.3",
    "sequelize": "4.44.4",
    "verify-cognito-token": "^1.2.2"
  },
  "engines": {
    "node": "16.x"
  }
}
