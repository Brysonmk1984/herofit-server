{
  "name": "stravat-cognito",
  "version": "1.9.9",
  "description": "Backend for HeroFit",
  "main": "start.js",
  "scripts": {
    "test": "jest --verbose --ci --runInBand --forceExit",
    "test:precommit": "jest --verbose --ci  --coverage --forceExit",
    "test:watch": "jest --watch --verbose ",
    "start": "NODE_ENV=production node build/start.js",
    "dev": "NODE_ENV=development ts-node-dev  --respawn --transpile-only --no-deps --exit-child --watch src  ./src/start.ts",
    "dev:local": "NODE_ENV=development ts-node-dev  --respawn --transpile-only --watch src  ./src/start.ts",
    "prettier": "prettier --check .",
    "lint": "eslint . --ext .ts",
    "build": "tsc-silent -p tsconfig.json --suppress @",
    "herofit-prod-build": "tsc-silent -p tsconfig.prod.json --suppress @ && mv -f src/jwt/id_rsa_priv.pem build/jwt/id_rsa_priv.pem && mv -f src/jwt/id_rsa_pub.pem build/jwt/id_rsa_pub.pem"
  },
  "author": "Bryson Kruk",
  "license": "MIT",
  "devDependencies": {
    "@types/express": "^4.17.13",
    "@types/jest": "^27.4.1",
    "@types/passport": "^1.0.7",
    "@types/passport-jwt": "^3.0.6",
    "@types/sequelize": "^4.28.11",
    "@typescript-eslint/eslint-plugin": "^5.8.1",
    "@typescript-eslint/parser": "^5.8.1",
    "eslint": "^7.32.0",
    "eslint-config-airbnb": "^18.2.1",
    "eslint-config-airbnb-typescript": "^16.1.0",
    "eslint-config-prettier": "^8.3.0",
    "eslint-plugin-import": "^2.24.1",
    "eslint-plugin-node": "^4.2.2",
    "eslint-plugin-prettier": "^3.4.1",
    "eslint-plugin-promise": "^3.5.0",
    "husky": "^7.0.4",
    "jest": "^27.0.3",
    "jest-extended": "^0.11.5",
    "prettier": "^2.5.1",
    "supertest": "^3.4.2",
    "ts-jest": "^27.1.2",
    "ts-node": "^10.4.0",
    "ts-node-dev": "^1.1.8",
    "tsc-watch": "^5.0.3",
    "typescript": "^4.5.4"
  },
  "dependencies": {
    "@sentry/node": "^6.16.1",
    "@sentry/tracing": "^6.16.1",
    "@types/chance": "^1.1.3",
    "@types/nodemailer": "^6.4.4",
    "axios": "^0.21.4",
    "base64url": "^3.0.1",
    "body-parser": "^1.19.0",
    "chance": "^1.1.7",
    "connect-flash": "^0.1.1",
    "cors": "^2.8.3",
    "dotenv": "^6.2.0",
    "express": "^4.17.2",
    "express-fileupload": "^1.2.0",
    "express-response-formatter": "^2.0.2",
    "express-validator": "^6.10.0",
    "jsonwebtoken": "^9.0.0",
    "jwk-to-pem": "^2.0.4",
    "moment": "^2.29.1",
    "morgan": "^1.10.0",
    "nodemailer": "^6.6.1",
    "passport": "^0.4.1",
    "passport-http": "^0.3.0",
    "passport-jwt": "^4.0.0",
    "passport-local": "^1.0.0",
    "pg": "^8.7.1",
    "pg-hstore": "^2.3.3",
    "sequelize": "4.44.4",
    "tsc-silent": "^1.2.1",
    "verify-cognito-token": "^1.2.2"
  },
  "engines": {
    "node": "16.x"
  }
}
