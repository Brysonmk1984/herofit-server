{
  "name": "stravat-cognito",
  "version": "1.9.5",
  "description": "Backend for HeroFit",
  "main": "start.js",
  "scripts": {
    "test": "jest --verbose --detectOpenHandles",
    "test:watch": "jest --watch --verbose ",
    "start": "NODE_ENV=production node start.js",
    "dev": "NODE_ENV=development nodemon start.js"
  },
  "jest": {
    "watchPathIgnorePatterns": [
      "node_modules"
    ],
    "testEnvironment": "node",
    "setupFilesAfterEnv": [
      "./__tests__/setup/nullOrAny.setup.js",
      "jest-extended"
    ],
    "testPathIgnorePatterns": [
      "./__tests__/setup",
      "./__tests__/battles",
      "./__tests__/activityTraits",
      "./__tests__/itemRewards"
    ]
  },
  "author": "Bryson Kruk",
  "license": "MIT",
  "devDependencies": {
    "eslint": "^3.19.0",
    "eslint-config-standard": "^10.2.1",
    "eslint-plugin-import": "^2.22.1",
    "eslint-plugin-node": "^4.2.2",
    "eslint-plugin-promise": "^3.5.0",
    "eslint-plugin-standard": "^3.0.1",
    "jest": "^26.6.1",
    "jest-extended": "^0.11.5",
    "nodemon": "^2.0.6",
    "supertest": "^3.4.2"
  },
  "dependencies": {
    "axios": "^0.21.4",
    "base64url": "^3.0.1",
    "body-parser": "^1.19.0",
    "chance": "^1.1.7",
    "connect-flash": "^0.1.1",
    "cors": "^2.8.3",
    "dotenv": "^6.2.0",
    "express": "^4.17.1",
    "express-fileupload": "^1.2.0",
    "express-response-formatter": "^2.0.2",
    "express-validator": "^6.10.0",
    "jsonwebtoken": "^8.5.1",
    "jwk-to-pem": "^2.0.4",
    "moment": "^2.29.1",
    "morgan": "^1.10.0",
    "nodemailer": "^6.6.1",
    "passport": "^0.4.1",
    "passport-http": "^0.3.0",
    "passport-jwt": "^4.0.0",
    "passport-local": "^1.0.0",
    "pg": "^6.1.5",
    "pg-hstore": "^2.3.3",
    "sequelize": "4.44.4",
    "verify-cognito-token": "^1.2.2"
  },
  "engines": {
    "node": "13.x"
  }
}
